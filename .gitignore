# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
venv/
env/
ENV/
.venv/

# ===== Data (never commit raw or processed data) =====
data/raw/
data/processed/*.parquet
data/processed/*.pkl
data/processed/*.csv
!data/processed/.gitkeep
!data/raw/.gitkeep

# ===== Results (models and figures are large) =====
results/models/*.pkl
results/figures/*.png
results/logs/
!results/.gitkeep
!results/figures/.gitkeep
!results/models/.gitkeep

# ===== Jupyter =====
.ipynb_checkpoints/
*.ipynb

# ===== IDE =====
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Logs =====
*.log
logs/

# ===== Misc =====
*.tmp
*.bak
